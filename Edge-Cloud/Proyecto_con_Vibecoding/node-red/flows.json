    {
        "id": "mqtt_in_sensores",
        "type": "mqtt in",
        "z": "tab_nexoriego",
        "name": "Telemetría ESP32",
        "topic": "soa/grupo05/nexoriego/sensores",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_emqx",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 140,
        "wires": [["fn_process_telemetry"]]
    },
    {
        "id": "fn_process_telemetry",
        "type": "function",
        "z": "tab_nexoriego",
        "name": "Procesar Telemetría y Alertas Edge",
        "func": "const data = msg.payload;\nif (!data || typeof data !== 'object') {\n    return null;\n}\n\nconst alerts = [];\nif (data.estado === 'Falta de agua') {\n    alerts.push('CRITICA: Tanque agotado, requiere reset');\n}\nif (typeof data.humedad === 'number' && data.humedad < 25) {\n    alerts.push('SEQUIA: Humedad del suelo por debajo de 25%');\n}\nif (typeof data.temperatura === 'number' && data.temperatura > 32) {\n    alerts.push('TERMICA: Temperatura ambiente superior a 32 C');\n}\n\nconst enriched = {\n    timestamp: new Date().toISOString(),\n    node_id: 'esp32-nexoriego-01',\n    estado: data.estado || 'Desconocido',\n    motivo: data.motivo || 'Sin registro',\n    humedad: Number(data.humedad || 0),\n    temperatura: Number(data.temperatura || 0),\n    luz: Number(data.luz || 0),\n    fuente_luz: data.fuente_luz || 'ESP32',\n    regadas: Number(data.regadas || 0),\n    max_regadas: Number(data.max_regadas || 2),\n    alerts: alerts\n};\n\nflow.set('lastTelemetry', enriched);\n\nlet history = flow.get('history') || [];\nhistory.push(enriched);\nif (history.length > 100) {\n    history = history.slice(history.length - 100);\n}\nflow.set('history', history);\n\nconst logMsg = { payload: JSON.stringify(enriched) };\nconst humMsg = { payload: enriched.humedad, topic: 'Humedad (%)' };\nconst tempMsg = { payload: enriched.temperatura, topic: 'Temperatura (C)' };\nconst luzMsg = { payload: enriched.luz, topic: 'Luz' };\nconst uiMsg = { payload: enriched };\n\nreturn [uiMsg, logMsg, humMsg, tempMsg, luzMsg];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 140,
        "wires": [
            ["ui_txt_estado", "ui_txt_motivo", "ui_txt_fuente", "ui_txt_ciclos", "ui_txt_alerta"],
            ["file_log_jsonl"],
            ["ui_gauge_humedad", "ui_chart_clima"],
            ["ui_gauge_temp", "ui_chart_clima"],
            ["ui_gauge_luz"]
        ]
    },
