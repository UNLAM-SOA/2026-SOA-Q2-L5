    {
        "id": "http_in_status",
        "type": "http in",
        "z": "tab_nexoriego",
        "name": "GET /api/status",
        "url": "/api/status",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 580,
        "wires": [["fn_api_status"]]
    },
    {
        "id": "fn_api_status",
        "type": "function",
        "z": "tab_nexoriego",
        "name": "Leer Último Estado",
        "func": "const last = flow.get('lastTelemetry');\nif (!last) {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Sin telemetría recibida aún' };\n} else {\n    msg.statusCode = 200;\n    msg.payload = last;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 580,
        "wires": [["http_res_api"]]
    },
    {
        "id": "http_in_history",
        "type": "http in",
        "z": "tab_nexoriego",
        "name": "GET /api/history",
        "url": "/api/history",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 640,
        "wires": [["fn_api_history"]]
    },
    {
        "id": "fn_api_history",
        "type": "function",
        "z": "tab_nexoriego",
        "name": "Leer Histórico",
        "func": "const history = flow.get('history') || [];\nmsg.statusCode = 200;\nmsg.payload = { count: history.length, items: history };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 370,
        "y": 640,
        "wires": [["http_res_api"]]
    },
    {
        "id": "http_in_command",
        "type": "http in",
        "z": "tab_nexoriego",
        "name": "POST /api/command",
        "url": "/api/command",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 150,
        "y": 700,
        "wires": [["fn_api_command"]]
    },
    {
        "id": "fn_api_command",
        "type": "function",
        "z": "tab_nexoriego",
        "name": "Validar y Despachar Comando",
        "func": "const cmd = msg.payload && typeof msg.payload.cmd === 'string' ? msg.payload.cmd.trim() : '';\nconst isValid = cmd === 'regar' || cmd === 'reset' || /^luz:-?\\d+$/.test(cmd);\nif (!isValid) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Comando inválido. Permitidos: regar, reset, luz:<entero>' };\n    return [msg, null];\n}\n\nconst httpResp = {\n    ...msg,\n    statusCode: 202,\n    payload: { accepted: true, cmd: cmd, topic: 'soa/grupo05/nexoriego/comandos' }\n};\nconst mqttMsg = {\n    topic: 'soa/grupo05/nexoriego/comandos',\n    payload: cmd\n};\nreturn [httpResp, mqttMsg];",
        "outputs": 2,
        "noerr": 0,
        "x": 400,
        "y": 700,
        "wires": [["http_res_api"], ["mqtt_out_comandos"]]
    },
